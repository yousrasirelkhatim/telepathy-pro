{
  "hosting": {
    "site": "four-fruits-fun",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "/admin", "destination": "/admin.html" },
      { "source": "/play",  "destination": "/play.html" },
      { "source": "/card",  "destination": "/card.html" },
      { "source": "/my",    "destination": "/my.html" },
      { "source": "/payment-success", "destination": "/payment-success.html" },
      { "source": "/payment-cancel", "destination": "/payment-cancel.html" },
      { "source": "**",     "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|svg|png|jpg|webp)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
      },
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  },
  "functions": {
    "source": "functions",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*.local"
    ]
  }
}
