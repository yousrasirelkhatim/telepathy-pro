# =============================================================================
# .env.paymob.example  →  copy to  .env.paymob.new  and fill values
#
# These are the 4 credentials required to switch the Paymob account used by
# Telepathy Challenge. Get all 4 from the NEW Paymob dashboard:
#
#   - Secret Key & Public Key & HMAC:   Settings → API Keys
#   - Integration IDs:                  Integrations / Payment Methods page
#
# HOW TO USE:
#   cp scripts/.env.paymob.example scripts/.env.paymob.new
#   $EDITOR scripts/.env.paymob.new     # fill the values
#   bash scripts/switch-paymob-account.sh
#
# The script wipes .env.paymob.new automatically after applying the change.
# NEVER commit the .new file (it is git-ignored, but double-check).
# =============================================================================

# From Paymob dashboard → Settings → API Keys → "المفتاح السري" (Secret Key)
PAYMOB_SECRET_KEY=

# From Paymob dashboard → Settings → API Keys → "مفتاح HMAC"
PAYMOB_HMAC_SECRET=

# From Paymob dashboard → Settings → API Keys → "المفتاح العام" (Public Key)
PAYMOB_PUBLIC_KEY=

# From Paymob dashboard → Integrations page
# Comma-separated numeric IDs for enabled payment methods (card / wallet / InstaPay)
# Example:  12345,67890
PAYMOB_INTEGRATION_IDS=
