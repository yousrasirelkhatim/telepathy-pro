{
  "rules": {
    "rooms": {
      "$roomId": {
        ".read": "$roomId.matches(/^[A-Z0-9]{6}$/)",
        ".write": "$roomId.matches(/^[A-Z0-9]{6}$/)",
        "code": { ".validate": "newData.isString() && newData.val() === $roomId" },
        "status": { ".validate": "newData.isString() && (newData.val() === 'waiting' || newData.val() === 'playing')" },
        "phase": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4" },
        "round": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5" },
        "maxUses": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 50" },
        "totalUses": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 51" },
        "expired": { ".validate": "newData.isBoolean()" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "accessCode": { ".validate": "newData.isString() && newData.val().length <= 24" },
        "accessConsumed": { ".validate": "newData.isBoolean()" },
        "players": {
          "$pid": {
            ".validate": "$pid === 'player1' || $pid === 'player2'",
            "name":  { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30" },
            "id":    { ".validate": "newData.isString() && newData.val().length <= 64" },
            "authUid": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "ready": { ".validate": "newData.isBoolean()" },
            "photo": { ".validate": "newData.isString() && newData.val().length <= 200000" },
            "$other": { ".validate": false }
          }
        },
        "answers": {
          "$pid": {
            ".validate": "$pid === 'player1' || $pid === 'player2'",
            "$phase": {
              ".validate": "$phase.matches(/^phase[1-4]$/)",
              "$round": { ".validate": "newData.isString() && newData.val().length <= 60" }
            }
          }
        },
        "roundSubmissions": {
          "$rk": {
            ".validate": "$rk.matches(/^p[1-4]_r[0-4]$/)",
            "$pid": { ".validate": "($pid === 'player1' || $pid === 'player2') && newData.isBoolean()" }
          }
        },
        "gameState": { ".validate": "newData.hasChild('event')" },
        "$other": { ".validate": false }
      }
    },

    "accessRooms": {
      "$code": {
        ".read": "$code.matches(/^[A-Z0-9-]{1,24}$/)",
        ".write": "$code.matches(/^[A-Z0-9-]{1,24}$/)",
        "roomId": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{6}$/)" },
        "at": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "orderRateLimit": {
      "$phoneKey": {
        ".read": false,
        ".write": "!data.exists() || (newData.isNumber() && newData.val() - data.val() >= 50000)",
        ".validate": "newData.isNumber()"
      }
    },

    "accessCodes": {
      ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || (query.orderByChild === 'resellerId' && query.equalTo === auth.uid))",
      ".indexOn": ["status", "ownerId", "batchId", "createdAt", "resellerId", "sold"],
      "$code": {
        ".read": true,
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (root.child('resellers').child(auth.uid).child('active').val() === true && (!data.exists() || data.child('resellerId').val() === auth.uid)))",
        ".validate": "newData.hasChildren(['type','status','maxSessions','usedSessions','createdAt'])",
        "type": { ".validate": "newData.isString() && (newData.val() === 'individual' || newData.val() === 'business' || newData.val() === 'session')" },
        "status": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true || (data.parent().child('status').val() === 'active' && newData.isString() && newData.val().matches(/^(active|used|expired)$/))",
          ".validate": "newData.isString() && newData.val().matches(/^(active|used|expired|disabled)$/)"
        },
        "maxSessions": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 50" },
        "usedSessions": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true || (data.parent().child('status').val() === 'active' && newData.isNumber() && newData.val() === data.val() + 1 && newData.val() <= data.parent().child('maxSessions').val())",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 51"
        },
        "expiresAt": { ".validate": "newData.isNumber()" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "ownerId": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "batchId": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "resellerId": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "soldPrice": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "sold": { ".write": "auth != null && root.child('admins').child(auth.uid).val() === true", ".validate": "newData.isBoolean()" },
        "soldAt": { ".write": "auth != null && root.child('admins').child(auth.uid).val() === true", ".validate": "newData.isNumber()" },
        "soldBy": { ".write": "auth != null && root.child('admins').child(auth.uid).val() === true", ".validate": "newData.isString() && newData.val().length <= 64" },
        "soldToName": { ".write": "auth != null && root.child('admins').child(auth.uid).val() === true", ".validate": "newData.isString() && newData.val().length <= 80" },
        "soldToPhone": { ".write": "auth != null && root.child('admins').child(auth.uid).val() === true", ".validate": "newData.isString() && newData.val().length <= 30" },
        "soldOrderId": { ".write": "auth != null && root.child('admins').child(auth.uid).val() === true", ".validate": "newData.isString() && newData.val().length <= 64" },
        "soldPackageId": { ".write": "auth != null && root.child('admins').child(auth.uid).val() === true", ".validate": "newData.isString() && newData.val().length <= 64" },
        "label": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "sessionId": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "ownerPhoneKey": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "lastUsedAt": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true || (data.parent().child('status').val() === 'active' && newData.isNumber())",
          ".validate": "newData.isNumber()"
        },
        "$other": { ".validate": false }
      }
    },

    "businesses": {
      ".read":  "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["createdAt"]
    },

    "batches": {
      ".read":  "auth != null && (root.child('admins').child(auth.uid).val() === true || (query.orderByChild === 'resellerId' && query.equalTo === auth.uid))",
      ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('resellers').child(auth.uid).child('active').val() === true)",
      ".indexOn": ["createdAt", "businessId", "resellerId"]
    },

    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.isBoolean()"
      }
    },

    "publicConfig": {
      ".read": true,
      ".write": false,
      "bootstrapPhone": { ".validate": "newData.isString() && newData.val().length <= 20" }
    },

    "resellers": {
      ".read":  "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["createdAt", "email"],
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        "balance": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && newData.isNumber() && newData.val() >= 0 && newData.val() <= data.val()))",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "totalGenerated": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && newData.isNumber() && newData.val() >= data.val()))",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "totalSpent": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && newData.isNumber() && newData.val() >= data.val()))",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "active":      { ".validate": "newData.isBoolean()" },
        "email":       { ".validate": "newData.isString() && newData.val().length <= 80" },
        "name":        { ".validate": "newData.isString() && newData.val().length <= 60" },
        "phone":       { ".validate": "newData.isString() && newData.val().length <= 30" },
        "tier":        { ".validate": "newData.isString() && newData.val().length <= 20" },
        "discountPct": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 90" },
        "createdAt":   { ".validate": "newData.isNumber()" },
        "notes":       { ".validate": "newData.isString() && newData.val().length <= 200" },
        "$other":      { ".validate": false }
      }
    },

    "resellerOps": {
      ".read":  "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["resellerId", "at", "type"],
      "$opId": {
        ".read":  "auth != null && (root.child('admins').child(auth.uid).val() === true || data.child('resellerId').val() === auth.uid)",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (root.child('resellers').child(auth.uid).child('active').val() === true && newData.child('resellerId').val() === auth.uid && !data.exists()))",
        ".validate": "newData.hasChildren(['resellerId','type','at'])"
      }
    },

    "pricing": {
      ".read":  true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },

    "packages": {
      ".read":  true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["order", "visible"],
      "$pkgId": {
        ".validate": "newData.hasChildren(['name','price'])",
        "name":          { ".validate": "newData.isString() && newData.val().length <= 60" },
        "desc":          { ".validate": "newData.isString() && newData.val().length <= 200" },
        "icon":          { ".validate": "newData.isString() && newData.val().length <= 8" },
        "price":         { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000" },
        "currency":      { ".validate": "newData.isString() && newData.val().length <= 6" },
        "codesCount":    { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10000" },
        "sessionsPerCode": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100" },
        "features":      { ".validate": "newData.isString() && newData.val().length <= 1000" },
        "badge":         { ".validate": "newData.isString() && newData.val().length <= 30" },
        "featured":      { ".validate": "newData.isBoolean()" },
        "buttonText":    { ".validate": "newData.isString() && newData.val().length <= 30" },
        "order":         { ".validate": "newData.isNumber()" },
        "visible":       { ".validate": "newData.isBoolean()" },
        "whatsappMsg":   { ".validate": "newData.isString() && newData.val().length <= 200" },
        "unitNote":      { ".validate": "newData.isString() && newData.val().length <= 60" },
        "$other":        { ".validate": false }
      }
    },

    "orders": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["status", "createdAt", "buyerPhone", "packageId"],
      "$orderId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true || (!data.exists() && newData.child('status').val() === 'pending')",
        ".validate": "newData.hasChildren(['packageId','packageName','status','codesCount','sessionsPerCode','price','currency','buyerName','buyerPhone','createdAt'])",
        "packageId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64" },
        "packageName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
        "packageType": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "status": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (data.parent().child('phoneKey').exists() && root.child('phoneIndex').child(data.parent().child('phoneKey').val()).child('authUid').val() === auth.uid && data.val() === 'pending' && newData.val() === 'cancelled'))",
          ".validate": "newData.isString() && newData.val().matches(/^(pending|fulfilled|cancelled)$/)"
        },
        "codesCount": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10000" },
        "sessionsPerCode": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100" },
        "price": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000" },
        "currency": { ".validate": "newData.isString() && newData.val().length <= 8" },
        "buyerName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
        "buyerPhone": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30" },
        "buyerEmail": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "notes": { ".validate": "newData.isString() && newData.val().length <= 300" },
        "source": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "phoneKey": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "fulfilledAt": { ".validate": "newData.isNumber()" },
        "fulfilledBy": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "code": { ".validate": "newData.isString() && newData.val().length <= 24" },
        "codes": { "$idx": { ".validate": "newData.isString() && newData.val().length <= 24" } },
        "cancelledAt": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (data.parent().child('phoneKey').exists() && root.child('phoneIndex').child(data.parent().child('phoneKey').val()).child('authUid').val() === auth.uid && data.parent().child('status').val() === 'pending'))",
          ".validate": "newData.isNumber()"
        },
        "cancelledBy": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (data.parent().child('phoneKey').exists() && root.child('phoneIndex').child(data.parent().child('phoneKey').val()).child('authUid').val() === auth.uid && data.parent().child('status').val() === 'pending' && newData.val() === auth.uid))",
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "paymentMethod": { ".validate": "newData.isString() && newData.val().matches(/^(whatsapp|stripe|paymob)$/)" },
        "paymentStatus": { ".validate": "newData.isString() && newData.val().matches(/^(pending|paid|failed)$/)" },
        "stripeSessionId": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "stripePaymentIntentId": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "paymobIntentionId": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "paymobTransactionId": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "paymobOrderId": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "paidAt": { ".validate": "newData.isNumber()" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "sessionCodes": { "$idx": { ".validate": "newData.isString() && newData.val().length <= 24" } },
        "promoCode":          { ".validate": "newData.isString() && newData.val().length <= 24" },
        "originalPrice":      { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "discountAmount":     { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "affiliateId":        { ".validate": "newData.isString() && newData.val().length <= 64" },
        "affiliateCommission":{ ".validate": "newData.isNumber() && newData.val() >= 0" },
        "$other": { ".validate": false }
      }
    },

    "phoneIndex": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["authUid", "role", "registeredAt"],
      "$phoneKey": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || !data.exists() || data.child('authUid').val() === auth.uid || (auth.token.phone_number != null && auth.token.phone_number.endsWith($phoneKey)))",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (newData.child('authUid').val() === auth.uid && auth.token.phone_number != null && auth.token.phone_number.endsWith($phoneKey)))",
        "authUid": {
          ".validate": "newData.isString() && newData.val().length <= 64"
        },
        "phone": { ".validate": "newData.isString() && newData.val().length <= 30" },
        "name": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "role": { ".validate": "newData.isString() && newData.val().matches(/^(customer|pending_staff|reseller|admin)$/)" },
        "authMethod": { ".validate": "newData.isString() && newData.val().length <= 10" },
        "registeredAt": { ".validate": "newData.isNumber()" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "customerOrders": {
      "$phoneKey": {
        ".read": "auth != null && root.child('phoneIndex').child($phoneKey).child('authUid').val() === auth.uid",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        "$orderId": {
          ".write": "(auth != null && root.child('admins').child(auth.uid).val() === true) || (!data.exists() && root.child('orders').child($orderId).child('phoneKey').val() === $phoneKey && root.child('orders').child($orderId).child('status').val() === 'pending' && newData.child('status').val() === 'pending') || (auth != null && root.child('phoneIndex').child($phoneKey).child('authUid').val() === auth.uid && data.exists() && data.child('status').val() === 'cancelled' && !newData.exists())",
          "status": {
            ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (root.child('phoneIndex').child($phoneKey).child('authUid').val() === auth.uid && data.val() === 'pending' && newData.val() === 'cancelled'))",
            ".validate": "newData.isString() && newData.val().matches(/^(pending|fulfilled|cancelled)$/)"
          },
          "cancelledAt": {
            ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (root.child('phoneIndex').child($phoneKey).child('authUid').val() === auth.uid && root.child('customerOrders').child($phoneKey).child($orderId).child('status').val() === 'pending'))",
            ".validate": "newData.isNumber()"
          },
          "packageId": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "packageName": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "price": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "currency": { ".validate": "newData.isString() && newData.val().length <= 8" },
          "sessionsCount": { ".validate": "newData.isNumber() && newData.val() >= 1" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "fulfilledAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },

    "userData": {
      "$phoneKey": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('phoneIndex').child($phoneKey).child('authUid').val() === auth.uid)",
        "profile": {
          ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (!data.exists() && root.child('phoneIndex').child($phoneKey).child('authUid').val() === auth.uid && newData.hasChildren(['phone','phoneKey','role','name'])))",
          ".validate": "newData.hasChildren(['phone','phoneKey','role'])",
          "name": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "phone": { ".validate": "newData.isString() && newData.val().length <= 30" },
          "phoneKey": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "role": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "totalSessions": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "lastOrderId": { ".validate": "newData.isString() && newData.val().length <= 64" },
          "$other": { ".validate": false }
        },
        "orders": {
          "$orderId": {
            ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
            ".validate": "newData.isNumber()"
          }
        },
        "sessions": {
          "$sid": {
            ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (data.child('status').val() === 'available' && newData.child('status').val() === 'active' && root.child('accessCodes').child(data.child('sessionCode').val()).child('type').val() === 'session') || (data.child('status').val() === 'active' && newData.child('status').val() === 'used' && root.child('accessCodes').child(data.child('sessionCode').val()).child('type').val() === 'session') || (data.child('status').val() === 'active' && newData.child('status').val() === 'available' && root.child('phoneIndex').child($phoneKey).child('authUid').val() === auth.uid))",
            "index": { ".validate": "newData.isNumber() && newData.val() >= 1" },
            "sessionCode": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "status": { ".validate": "newData.isString() && newData.val().matches(/^(available|active|used|expired)$/)" },
            "orderId": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "packageId": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "roomId": { ".validate": "newData.isString() && newData.val().length <= 8" },
            "createdAt": { ".validate": "newData.isNumber()" },
            "usedAt": { ".validate": "newData.isNumber()" },
            "scorePct": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
            "partnerName": { ".validate": "newData.isString() && newData.val().length <= 30" },
            "$other": { ".validate": false }
          }
        }
      }
    },

    "sessionIndex": {
      "$code": {
        ".read": true,
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (!data.exists() && newData.hasChildren(['phoneKey','sessionId','status'])))",
        ".validate": "newData.hasChildren(['phoneKey','sessionId','status'])",
        "phoneKey": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "sessionId": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "status": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true || (data.parent().child('status').val() === 'available' && newData.val() === 'active') || (data.parent().child('status').val() === 'active' && newData.val() === 'used') || (data.parent().child('status').val() === 'active' && newData.val() === 'available') || newData.val() === 'expired'",
          ".validate": "newData.isString() && newData.val().matches(/^(available|active|used|expired)$/)"
        },
        "roomId": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true || data.parent().child('status').val().matches(/^(available|active)$/)",
          ".validate": "newData.isString() && newData.val().length <= 8"
        },
        "createdAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "paymobProcessed": {
      "$txnId": {
        ".read": false,
        ".write": false
      }
    },

    "stripeProcessed": {
      "$eventId": {
        ".read": false,
        ".write": false
      }
    },

    "settings": {
      ".read":  true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "whatsappNumber": { ".validate": "newData.isString() && newData.val().length <= 24" },
      "currency":       { ".validate": "newData.isString() && newData.val().length <= 6" },
      "brandName":      { ".validate": "newData.isString() && newData.val().length <= 40" },
      "tagline":        { ".validate": "newData.isString() && newData.val().length <= 200" },
      "heroTitle":      { ".validate": "newData.isString() && newData.val().length <= 120" },
      "heroBadge":      { ".validate": "newData.isString() && newData.val().length <= 60" },
      "heroStats":      { ".validate": "newData.isString() && newData.val().length <= 240" },
      "bizMessage":     { ".validate": "newData.isString() && newData.val().length <= 200" },
      "stripeEnabled":  { ".validate": "newData.isBoolean()" },
      "stripePublishableKey": { ".validate": "newData.isString() && newData.val().length <= 120" },
      "paymobEnabled":  { ".validate": "newData.isBoolean()" },
      "paymobPublicKey": { ".validate": "newData.isString() && newData.val().length <= 256" },
      "paymobIntegrationIds": { ".validate": "newData.isString() && newData.val().length <= 80" },
      "paymobCurrency": { ".validate": "newData.isString() && newData.val().length <= 6" },
      "paymobEgpRate":  { ".validate": "newData.isString() && newData.val().length <= 12" },
      "paymentsNote":   { ".validate": "newData.isString() && newData.val().length <= 200" },
      "contactPhone":   { ".validate": "newData.isString() && newData.val().length <= 40" },
      "contactEmail":   { ".validate": "newData.isString() && newData.val().length <= 80" },
      "contactAddress": { ".validate": "newData.isString() && newData.val().length <= 240" },
      "companyName":    { ".validate": "newData.isString() && newData.val().length <= 60" },
      "companyUrl":     { ".validate": "newData.isString() && newData.val().length <= 200" },
      "copyrightYear":  { ".validate": "newData.isString() && newData.val().length <= 10" },
      "singlePackageMode": { ".validate": "newData.isBoolean()" },
      "promoEnabled":      { ".validate": "newData.isBoolean()" },
      "featuredPackageId": { ".validate": "newData.isString() && newData.val().length <= 64" },
      "$other":         { ".validate": false }
    },

    "promoCodes": {
      ".read":  "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["status", "affiliateId", "createdAt"],
      "$code": {
        ".validate": "$code.matches(/^[A-Z0-9_-]{1,24}$/) && newData.hasChildren(['status','discountType','discountValue'])",
        "status":          { ".validate": "newData.isString() && newData.val().matches(/^(active|disabled|expired)$/)" },
        "discountType":    { ".validate": "newData.isString() && newData.val().matches(/^(percent|fixed)$/)" },
        "discountValue":   { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000" },
        "commissionType":  { ".validate": "newData.isString() && newData.val().matches(/^(percent|fixed)$/)" },
        "commissionValue": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000" },
        "affiliateId":     { ".validate": "newData.isString() && newData.val().length <= 64" },
        "affiliateName":   { ".validate": "newData.isString() && newData.val().length <= 80" },
        "usageLimit":      { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000" },
        "usedCount":       { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "minOrderAmount":  { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "expiresAt":       { ".validate": "newData.isNumber()" },
        "createdAt":       { ".validate": "newData.isNumber()" },
        "notes":           { ".validate": "newData.isString() && newData.val().length <= 200" },
        "$other":          { ".validate": false }
      }
    },

    "affiliates": {
      ".read":  "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["active", "createdAt"],
      "$affiliateId": {
        ".validate": "$affiliateId.matches(/^[a-zA-Z0-9_-]{1,40}$/)",
        "name":              { ".validate": "newData.isString() && newData.val().length <= 80" },
        "phone":             { ".validate": "newData.isString() && newData.val().length <= 30" },
        "email":             { ".validate": "newData.isString() && newData.val().length <= 80" },
        "active":            { ".validate": "newData.isBoolean()" },
        "payoutMethod":      { ".validate": "newData.isString() && newData.val().matches(/^(instapay|bank|wallet|cash)$/)" },
        "payoutRef":         { ".validate": "newData.isString() && newData.val().length <= 120" },
        "defaultCommissionType":  { ".validate": "newData.isString() && newData.val().matches(/^(percent|fixed)$/)" },
        "defaultCommissionValue": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000" },
        "notes":             { ".validate": "newData.isString() && newData.val().length <= 200" },
        "createdAt":         { ".validate": "newData.isNumber()" },
        "totalOrders":       { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "totalRevenue":      { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "totalDiscountGiven":{ ".validate": "newData.isNumber() && newData.val() >= 0" },
        "totalCommission":   { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "pendingCommission": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "paidCommission":    { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "lastPayoutAt":      { ".validate": "newData.isNumber()" },
        "$other":            { ".validate": false }
      }
    },

    "promoUses": {
      ".read":  "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["affiliateId", "code", "orderId", "at", "status"],
      "$opId": {
        ".validate": "newData.hasChildren(['code','orderId','at']) && $opId.matches(/^[A-Za-z0-9_-]{1,40}$/)",
        "code":            { ".validate": "newData.isString() && newData.val().length <= 24" },
        "affiliateId":     { ".validate": "newData.isString() && newData.val().length <= 64" },
        "orderId":         { ".validate": "newData.isString() && newData.val().length <= 40" },
        "buyerPhoneKey":   { ".validate": "newData.isString() && newData.val().length <= 20" },
        "originalPrice":   { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "discountAmount":  { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "finalPrice":      { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "commissionEarned":{ ".validate": "newData.isNumber() && newData.val() >= 0" },
        "at":              { ".validate": "newData.isNumber()" },
        "status":          { ".validate": "newData.isString() && newData.val().matches(/^(pending|confirmed|refunded)$/)" },
        "paymobTxnId":     { ".validate": "newData.isString() && newData.val().length <= 64" },
        "provider":        { ".validate": "newData.isString() && newData.val().length <= 20" },
        "$other":          { ".validate": false }
      }
    },

    "affiliatePayouts": {
      ".read":  "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["affiliateId", "at"],
      "$opId": {
        ".validate": "newData.hasChildren(['affiliateId','amount','at']) && $opId.matches(/^[A-Za-z0-9_-]{1,40}$/)",
        "affiliateId": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "amount":      { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "at":          { ".validate": "newData.isNumber()" },
        "note":        { ".validate": "newData.isString() && newData.val().length <= 200" },
        "$other":      { ".validate": false }
      }
    },

    "orderPromoIndex": {
      "$orderId": {
        ".read":  "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.isString() && newData.val().length <= 24"
      }
    },

    "faq": {
      ".read":  true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["order", "visible"],
      "$faqId": {
        ".validate": "$faqId.matches(/^[a-zA-Z0-9_-]{1,40}$/) && newData.hasChildren(['questionAr','answerAr'])",
        "questionAr": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 200" },
        "answerAr":   { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 4000" },
        "questionEn": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "answerEn":   { ".validate": "newData.isString() && newData.val().length <= 4000" },
        "order":      { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
        "visible":    { ".validate": "newData.isBoolean()" },
        "$other":     { ".validate": false }
      }
    },

    "stats": {
      ".read":  "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": false,
      "totals": {
        ".read": true,
        "sessionsPlayed": {
          ".write": "newData.isNumber() && (!data.exists() || newData.val() === data.val() + 1)",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "cardsShared": {
          ".write": "newData.isNumber() && (!data.exists() || newData.val() === data.val() + 1)",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "$other": { ".validate": false }
      }
    }
  }
}
